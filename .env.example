# Public application URL used for OAuth redirects and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Project Settings > API. These two values are safe for the browser;
# database access is still governed by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed by trusted administrative jobs only; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional in Phase 1. The map adapter reports an unavailable state when omitted.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only transactional provider shared by lead and review notifications.
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM_EMAIL=

# Admin email for studio review submissions. Uses the same Resend key above.
# For account-owner testing only: onboarding@resend.dev.
REVIEW_NOTIFICATION_FROM_EMAIL=
# Enable only after the review-notification migration has been applied.
REVIEW_NOTIFICATIONS_ENABLED=false
LISTING_APPROVAL_NOTIFICATIONS_ENABLED=false

# Server-only secrets for privacy-preserving abuse hashing and the notification retry endpoint.
# Generate independent random values with at least 32 characters.
LEAD_ABUSE_SECRET=
CRON_SECRET=

# Server-only HMAC secret for anonymous analytics session identifiers.
ANALYTICS_HASH_SECRET=
